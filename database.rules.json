{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['host','mode','status','players','order']) && newData.child('host').isString() && newData.child('mode').isString() && newData.child('status').isString()"
      }
    }
  }
}
