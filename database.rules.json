{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['host','mode','phase','players','turn','round','step','owners','log','createdAt']) && newData.child('players').childrenCount <= 6"
      }
    }
  }
}
